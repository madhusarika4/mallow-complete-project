# Local credentials and environment files
**/.env
**/.env.*
!**/.env.example

# Python environments and generated files
**/.venv/
**/venv/
**/__pycache__/
**/*.py[cod]
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/.coverage
**/htmlcov/

# Frontend dependencies and generated output
**/node_modules/
frontend/dist/
frontend/playwright-report/
frontend/test-results/
backend/eval/results/
npm-debug.log*

# Local databases and database backups may contain private family data
**/*.db
**/*.sqlite
**/*.sqlite3
**/*.db.*
**/*.bak

# Local audio captures and model files
**/*.wav
**/*.mp3
**/*.m4a
**/*.ogg
**/*.webm
**/*.flac
backend/models/

# Editor and operating-system files
.idea/
.DS_Store
Thumbs.db
